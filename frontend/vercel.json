{
  "git": { "deploymentEnabled": { "codex/post-release-improvements": false } },
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/ios-review-clarity": false,
      "codex/ios-first-update": false
    }
  }
}
