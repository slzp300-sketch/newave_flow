FROM gradle:8.6-jdk17 AS build
WORKDIR /app
COPY build.gradle settings.gradle ./
COPY src/main/java ./src/main/java
COPY src/main/resources/application.yml ./src/main/resources/application.yml
COPY src/main/resources/META-INF ./src/main/resources/META-INF
# Actual roster JSON is deliberately absent from the build context/image.
RUN gradle bootReviewJar --no-daemon -x test

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/build/libs/*-review.jar app.jar
ENV SPRING_PROFILES_ACTIVE=review
ENV JAVA_TOOL_OPTIONS="-Xmx256m -XX:MaxMetaspaceSize=160m"
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
